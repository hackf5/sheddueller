@page "/jobs"
@inherits DashboardPageComponent
@inject IJobInspectionReader Reader
@inject IJobManager JobManager
@inject DashboardLiveUpdateStream LiveUpdates
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject Microsoft.Extensions.Options.IOptions<ShedduellerDashboardOptions> DashboardOptions

<div class="jobs-page">
    <header class="jobs-header">
        <div>
            <h1>Jobs</h1>
            <p>@HeaderText</p>
        </div>

        <button class="jobs-clear-queued-button" type="button" title="@ClearQueuedButtonTitle"
                aria-label="@ClearQueuedButtonTitle" @onclick="ClearQueuedJobsAsync" disabled="@IsClearQueuedDisabled">
            <span class="material-symbols-outlined" aria-hidden="true">@ClearQueuedButtonIcon</span>
            <span>@ClearQueuedButtonText</span>
        </button>
    </header>

    <section class="jobs-view-bar" aria-label="Job view">
        <label class="jobs-view-select">
            <span class="jobs-filter-label">View</span>
            <select class="sd-table-select" value="@_selectedViewKey" @onchange="SetViewAsync" aria-label="Select job view">
                <optgroup label="Built-in">
                    <option value="@DashboardJobViews.BuiltInKey">@DashboardJobViews.BuiltInName</option>
                </optgroup>
                @if (SharedViews.Count > 0)
                {
                    <optgroup label="Shared Presets">
                        @foreach (var view in SharedViews)
                        {
                            <option value="@view.Key" @key="view.Key">@view.Name</option>
                        }
                    </optgroup>
                }
                @if (PersonalViews.Count > 0)
                {
                    <optgroup label="My Views">
                        @foreach (var view in PersonalViews)
                        {
                            <option value="@view.Key" @key="view.Key">@view.Name</option>
                        }
                    </optgroup>
                }
            </select>
        </label>
        <span class="jobs-view-status">@CurrentViewStatus</span>
        <div class="jobs-view-actions">
            <button type="button" @onclick="ToggleColumnEditor" aria-expanded="@_isColumnEditorOpen">
                <span class="material-symbols-outlined" aria-hidden="true">view_column</span>
                <span>Columns</span>
            </button>
            <button type="button" @onclick="SaveCurrentViewAsync" disabled="@(!CanSaveCurrentView)">
                <span class="material-symbols-outlined" aria-hidden="true">save</span>
                <span>Save</span>
            </button>
            <button type="button" @onclick="SaveViewAsAsync">
                <span class="material-symbols-outlined" aria-hidden="true">save_as</span>
                <span>Save As</span>
            </button>
            <button type="button" @onclick="SetPreferredViewAsync" disabled="@(!CanSetPreferredView)">
                <span class="material-symbols-outlined" aria-hidden="true">home</span>
                <span>Set Default</span>
            </button>
            @if (CurrentView?.Source == DashboardJobViewSource.Personal)
            {
                <button type="button" @onclick="RenameCurrentViewAsync">
                    <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                    <span>Rename</span>
                </button>
                <button class="jobs-view-delete" type="button" @onclick="DeleteCurrentViewAsync">
                    <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                    <span>Delete</span>
                </button>
            }
        </div>
    </section>

    @if (_isColumnEditorOpen)
    {
        <section class="jobs-column-editor" aria-label="Configure job columns">
            <div class="jobs-column-editor__header">
                <div>
                    <h2>Columns</h2>
                    <p>Choose and order fields for this view. Job ID remains visible so job details are always reachable.</p>
                </div>
                <button type="button" @onclick="ToggleColumnEditor" aria-label="Close column editor">
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
            </div>

            <div class="jobs-column-list">
                @for (var index = 0; index < _columns.Count; index++)
                {
                    var columnIndex = index;
                    var column = _columns[columnIndex];
                    <div class="jobs-column-row" @key="ColumnKey(column)">
                        @if (column.Kind == ShedduellerDashboardJobColumnKind.Tag)
                        {
                            <button type="button" title="Remove column" aria-label="Remove @DashboardJobViews.Heading(column) column"
                                    @onclick="() => RemoveColumn(columnIndex)">
                                <span class="material-symbols-outlined" aria-hidden="true">remove_circle</span>
                            </button>
                        }
                        else
                        {
                            <input type="checkbox" checked disabled="@(column.Kind == ShedduellerDashboardJobColumnKind.JobId)"
                                   aria-label="Show @DashboardJobViews.Heading(column) column"
                                   @onchange="eventArgs => SetBuiltInColumnVisible(column.Kind, eventArgs)" />
                        }
                        <span class="jobs-column-row__name">@DashboardJobViews.Heading(column)</span>
                        @if (column.Kind == ShedduellerDashboardJobColumnKind.Tag)
                        {
                            <span class="jobs-column-row__tag">tag: @column.TagName</span>
                        }
                        <button type="button" title="Move up" aria-label="Move @DashboardJobViews.Heading(column) column up"
                                disabled="@(columnIndex == 0)" @onclick="() => MoveColumn(columnIndex, -1)">
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_upward</span>
                        </button>
                        <button type="button" title="Move down" aria-label="Move @DashboardJobViews.Heading(column) column down"
                                disabled="@(columnIndex == _columns.Count - 1)" @onclick="() => MoveColumn(columnIndex, 1)">
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_downward</span>
                        </button>
                    </div>
                }
                @foreach (var kind in HiddenBuiltInColumns)
                {
                    <label class="jobs-column-row jobs-column-row--hidden" @key="kind">
                        <input type="checkbox" aria-label="Show @DashboardJobViews.Heading(new(kind)) column"
                               @onchange="eventArgs => SetBuiltInColumnVisible(kind, eventArgs)" />
                        <span class="jobs-column-row__name">@DashboardJobViews.Heading(new(kind))</span>
                        <span class="jobs-column-row__tag">hidden</span>
                    </label>
                }
            </div>

            <div class="jobs-tag-column-form">
                <label>
                    <span>Tag name</span>
                    <input list="jobs-observed-tag-names" @bind="_newTagName" placeholder="provider" />
                </label>
                <datalist id="jobs-observed-tag-names">
                    @foreach (var tagName in ObservedTagNames)
                    {
                        <option value="@tagName"></option>
                    }
                </datalist>
                <label>
                    <span>Heading <span class="jobs-field-optional">optional</span></span>
                    <input @bind="_newTagHeading" placeholder="Provider" />
                </label>
                <button type="button" @onclick="AddTagColumn">
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                    <span>Add Tag Column</span>
                </button>
                <button type="button" @onclick="ResetColumns">
                    <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
                    <span>Reset Layout</span>
                </button>
            </div>
        </section>
    }

    <section class="jobs-filter-bar" aria-label="Job filters">
        <div class="jobs-status-filter" role="group" aria-label="Filter by status">
            <span class="jobs-filter-label">Status</span>
            @foreach (var state in Enum.GetValues<JobState>())
            {
                <label class="@StatusFilterClass(state)">
                    <input type="checkbox" checked="@_filters.IsStateSelected(state)" @onchange="eventArgs => SetStateFilterAsync(state, eventArgs)" />
                    <span>@state</span>
                </label>
            }
        </div>

        <div class="jobs-text-filters">
            <select class="sd-table-select jobs-sort-filter" aria-label="Sort jobs"
                    value="@_filters.Sort" @onchange="SetSortAsync">
                <option value="@JobInspectionSort.Operational">Operational Order</option>
                <option value="@JobInspectionSort.NewestFirst">Newest First</option>
            </select>
            <DashboardSearchBox Value="@_filters.HandlerContains" ValueChanged="SetHandlerContainsAsync"
                                Placeholder="Handler contains..." AriaLabel="Filter by handler substring" />
            <DashboardSearchBox Value="@_filters.TagContains" ValueChanged="SetTagContainsAsync"
                                Placeholder="Tag contains..." AriaLabel="Filter by tag substring" />
            <DashboardSearchBox Value="@_filters.ConcurrencyGroupContains" ValueChanged="SetConcurrencyGroupContainsAsync"
                                Placeholder="Group contains..." AriaLabel="Filter by concurrency group substring" />
            <button class="jobs-clear-button" type="button" @onclick="ClearAllAsync" disabled="@(!_filters.HasAppliedFilters)">
                Clear Filters
            </button>
        </div>
    </section>

    @if (_actionMessage is not null)
    {
        <DashboardInlineAlert CssClass="@ActionAlertClass" Icon="@ActionAlertIcon">
            <span>@_actionMessage</span>
        </DashboardInlineAlert>
    }

    @if (_error is not null)
    {
        <section class="jobs-message jobs-message--error" aria-live="polite">
            <span class="material-symbols-outlined" aria-hidden="true">error</span>
            <div>
                <h2>Jobs failed to load</h2>
                <p>@_error</p>
            </div>
        </section>
    }
    else if (_page is null)
    {
        <section class="jobs-message" aria-live="polite">
            <span class="material-symbols-outlined" aria-hidden="true">progress_activity</span>
            <div>
                <h2>Loading jobs</h2>
                <p>Reading scheduler job records.</p>
            </div>
        </section>
    }
    else
    {
        @if (LiveRefresh.RefreshError is not null)
        {
            <DashboardInlineAlert CssClass="jobs-inline-alert jobs-inline-alert--error" Icon="warning">
                <span>Refresh failed: @LiveRefresh.RefreshError</span>
            </DashboardInlineAlert>
        }

        <div class="jobs-table-shell">
            <div class="jobs-table-wrap">
                <table class="jobs-table" style="@TableStyle">
                    <colgroup>
                        @foreach (var column in _columns)
                        {
                            <col style="@ColumnWidthStyle(column)" @key="ColumnKey(column)" />
                        }
                    </colgroup>
                    <thead>
                        <tr>
                            @foreach (var column in _columns)
                            {
                                <th class="@ColumnHeaderClass(column)" @key="ColumnKey(column)">@DashboardJobViews.Heading(column)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (_jobs.Count == 0)
                        {
                            <tr>
                                <td class="jobs-empty-row" colspan="@_columns.Count">@EmptyText</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var job in _jobs)
                            {
                                <tr @key="job.JobId">
                                    @foreach (var column in _columns)
                                    {
                                        @switch (column.Kind)
                                        {
                                            case ShedduellerDashboardJobColumnKind.JobId:
                                                <td><JobLink CssClass="jobs-id-link" JobId="job.JobId" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Enqueued:
                                                <td><TimestampBlock BaseClass="jobs-timestamp" Value="job.EnqueuedAtUtc" AllowFutureRelative="false" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.TerminalTime:
                                                <td><TimestampBlock BaseClass="jobs-timestamp" Value="DashboardFormat.TerminalTimestamp(job)" AllowFutureRelative="false" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.State:
                                                <td><StateBadge BaseClass="jobs-state" State="job.State" Href="@StateFilterHref(job.State)"
                                                                Title="@StateFilterTitle(job.State)" AriaLabel="@StateFilterTitle(job.State)" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Queue:
                                                <td><span class="@QueuePositionClass(job)" title="@QueuePositionTitle(job)">@QueuePositionText(job)</span></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Handler:
                                                <td><a class="jobs-handler jobs-filter-link" href="@HandlerFilterHref(job)"
                                                       title="@DashboardFormat.FullHandler(job)"
                                                       aria-label="@HandlerFilterTitle(job)">@DashboardFormat.ShortHandler(job)</a></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Tags:
                                                <td><TagChipList ClassPrefix="jobs-chip" Tags="@ResidualTags(job)" HrefFactory="TagFilterHref"
                                                                 LinkAriaLabelPrefix="Filter jobs by tag" MaxVisible="2" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Progress:
                                                <td><ProgressIndicator BaseClass="jobs-progress" Progress="job.LatestProgress" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Disposition:
                                                <td><span class="jobs-disposition @GetDispositionClass(job)"
                                                          title="@DashboardFormat.Disposition(job)">@DashboardFormat.Disposition(job)</span></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Groups:
                                                <td><ChipList ClassPrefix="jobs-chip" Values="job.ConcurrencyGroupKeys"
                                                              Title="@DashboardFormat.GroupKeysTitle(job.ConcurrencyGroupKeys)"
                                                              HrefFactory="GroupFilterHref" LinkAriaLabelPrefix="Filter jobs by group" /></td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Priority:
                                                <td class="jobs-table__number">@job.Priority</td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Attempts:
                                                <td class="jobs-table__number">@DashboardFormat.Attempts(job, compact: true)</td>
                                                break;
                                            case ShedduellerDashboardJobColumnKind.Tag:
                                                var values = TagValues(job, column);
                                                <td><ChipList ClassPrefix="jobs-derived-tag" Values="values"
                                                              Title="@TagValuesTitle(values)" MaxVisible="2"
                                                              HrefFactory="value => TagValueFilterHref(column, value)"
                                                              LinkAriaLabelPrefix="Filter jobs by tag value" /></td>
                                                break;
                                        }
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <footer class="jobs-pagination">
                <span>@ResultRangeText</span>
                @if (_page.ContinuationToken is not null)
                {
                    <button class="jobs-load-more-button" type="button" @onclick="LoadMoreAsync" disabled="@(_isLoading || _isLoadingMore)">
                        @(_isLoadingMore ? "Loading Records" : "Load More Records")
                    </button>
                }
            </footer>
        </div>
    }
</div>

<style>
    .jobs-page {
        display: flex;
        height: calc(100vh - (var(--sd-page-margin) * 2));
        min-height: 0;
        flex-direction: column;
        gap: var(--sd-gutter);
    }

    .jobs-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .jobs-header p {
        margin-top: 4px;
        color: var(--sd-on-surface-variant);
        font-size: 12px;
        line-height: 16px;
    }

    .jobs-view-bar {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: var(--sd-radius);
        background: var(--sd-surface-lowest);
        padding: 8px;
    }

    .jobs-view-select {
        display: flex;
        min-width: 220px;
        align-items: center;
        gap: 8px;
    }

    .jobs-view-select .sd-table-select {
        min-width: 160px;
    }

    .jobs-view-status {
        flex: 1 1 auto;
        overflow: hidden;
        color: var(--sd-on-surface-variant);
        font-size: 11px;
        line-height: 16px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .jobs-view-actions {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .jobs-view-actions button,
    .jobs-column-editor button,
    .jobs-tag-column-form button {
        display: inline-flex;
        min-height: 32px;
        align-items: center;
        justify-content: center;
        gap: 4px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 2px;
        background: var(--sd-surface-lowest);
        color: var(--sd-on-surface);
        padding: 6px 8px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.04em;
        line-height: 12px;
        text-transform: uppercase;
    }

    .jobs-view-actions button:hover:not(:disabled),
    .jobs-column-editor button:hover:not(:disabled),
    .jobs-tag-column-form button:hover:not(:disabled) {
        border-color: var(--sd-primary);
        color: var(--sd-primary);
    }

    .jobs-view-actions button:disabled,
    .jobs-column-editor button:disabled {
        cursor: default;
        opacity: 0.5;
    }

    .jobs-view-actions .material-symbols-outlined,
    .jobs-column-editor .material-symbols-outlined,
    .jobs-tag-column-form .material-symbols-outlined {
        font-size: 16px;
    }

    .jobs-view-actions .jobs-view-delete {
        color: var(--sd-error);
    }

    .jobs-column-editor {
        display: grid;
        gap: 12px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: var(--sd-radius);
        background: var(--sd-surface-lowest);
        padding: 12px;
    }

    .jobs-column-editor__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
    }

    .jobs-column-editor__header h2 {
        font-size: 14px;
        line-height: 20px;
    }

    .jobs-column-editor__header p {
        color: var(--sd-on-surface-variant);
        font-size: 11px;
        line-height: 16px;
    }

    .jobs-column-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 4px;
    }

    .jobs-column-row {
        display: grid;
        min-height: 34px;
        align-items: center;
        gap: 6px;
        grid-template-columns: 28px minmax(80px, 1fr) minmax(0, auto) 28px 28px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 2px;
        background: var(--sd-surface-low);
        padding: 3px 4px;
    }

    .jobs-column-row--hidden {
        grid-template-columns: 28px minmax(80px, 1fr) auto;
        color: var(--sd-on-surface-variant);
        opacity: 0.8;
    }

    .jobs-column-row button {
        min-height: 26px;
        padding: 3px;
    }

    .jobs-column-row__name {
        overflow: hidden;
        font-size: 11px;
        font-weight: 600;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .jobs-column-row__tag,
    .jobs-field-optional {
        overflow: hidden;
        color: var(--sd-on-surface-variant);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: 10px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .jobs-tag-column-form {
        display: flex;
        align-items: end;
        flex-wrap: wrap;
        gap: 8px;
        border-top: 1px solid var(--sd-outline-variant);
        padding-top: 12px;
    }

    .jobs-tag-column-form label {
        display: grid;
        min-width: 180px;
        gap: 3px;
        color: var(--sd-on-surface-variant);
        font-size: 11px;
        font-weight: 600;
    }

    .jobs-tag-column-form input {
        min-height: 32px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 2px;
        background: var(--sd-surface-lowest);
        color: var(--sd-on-surface);
        padding: 6px 8px;
        font-size: 12px;
    }

    .jobs-filter-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px 12px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: var(--sd-radius);
        background: var(--sd-surface-lowest);
        padding: 8px;
    }

    .jobs-status-filter,
    .jobs-text-filters {
        display: flex;
        min-width: 0;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .jobs-text-filters {
        flex: 1 1 560px;
    }

    .jobs-filter-label {
        color: var(--sd-on-surface-variant);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        line-height: 12px;
        text-transform: uppercase;
    }

    .jobs-status-option {
        position: relative;
        display: inline-flex;
        cursor: pointer;
    }

    .jobs-status-option input {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
    }

    .jobs-status-option span {
        display: inline-flex;
        min-height: 32px;
        align-items: center;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 2px;
        background: var(--sd-surface-container);
        color: var(--sd-on-surface-variant);
        padding: 6px 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        line-height: 12px;
        text-transform: uppercase;
        transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
    }

    .jobs-status-option input:checked+span {
        border-color: var(--sd-primary);
        background: var(--sd-secondary-container);
        color: var(--sd-on-secondary-container);
    }

    .jobs-status-option input:focus-visible+span {
        outline: 2px solid var(--sd-primary);
        outline-offset: 2px;
    }

    .jobs-filter-bar .sd-table-search {
        flex: 1 1 190px;
        width: auto;
        min-width: 180px;
    }

    .jobs-filter-bar .sd-table-select {
        flex: 0 0 166px;
        min-width: 150px;
    }

    button.jobs-clear-button,
    button.jobs-clear-queued-button,
    button.jobs-load-more-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        min-height: 32px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 2px;
        background: var(--sd-surface-lowest);
        color: var(--sd-on-surface);
        padding: 6px 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        line-height: 12px;
        text-transform: uppercase;
    }

    button.jobs-clear-queued-button {
        border-color: var(--sd-error);
        background: var(--sd-error-container);
        color: var(--sd-on-error-container);
    }

    button.jobs-clear-queued-button .material-symbols-outlined {
        font-size: 17px;
    }

    button.jobs-load-more-button {
        min-width: 160px;
    }

    button.jobs-clear-button:hover,
    button.jobs-clear-queued-button:hover,
    button.jobs-load-more-button:hover {
        color: var(--sd-primary);
    }

    button.jobs-clear-queued-button:hover:not(:disabled) {
        border-color: var(--sd-error);
        color: var(--sd-error);
    }

    .jobs-page button:disabled,
    .jobs-page input:disabled {
        cursor: progress;
        opacity: 0.65;
    }

    .jobs-message,
    .jobs-inline-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 2px;
        background: var(--sd-surface-lowest);
        padding: 16px;
    }

    .jobs-message .material-symbols-outlined,
    .jobs-inline-alert .material-symbols-outlined {
        color: var(--sd-primary);
    }

    .jobs-message--error,
    .jobs-inline-alert--error {
        border-color: var(--sd-error);
        background: var(--sd-error-container);
        color: var(--sd-on-error-container);
    }

    .jobs-message--error .material-symbols-outlined,
    .jobs-inline-alert--error .material-symbols-outlined {
        color: var(--sd-error);
    }

    .jobs-inline-alert--success {
        border-color: var(--sd-success);
        background: var(--sd-success-container);
        color: var(--sd-success);
    }

    .jobs-inline-alert--success .material-symbols-outlined {
        color: var(--sd-success);
    }

    .jobs-inline-alert--warning {
        border-color: var(--sd-warning);
        background: var(--sd-warning-container);
        color: var(--sd-warning);
    }

    .jobs-inline-alert--warning .material-symbols-outlined {
        color: var(--sd-warning);
    }

