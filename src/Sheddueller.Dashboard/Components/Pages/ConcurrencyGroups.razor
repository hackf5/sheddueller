@page "/concurrency-groups"
@inherits DashboardPageComponent
@inject IConcurrencyGroupInspectionReader Reader
@inject IServiceProvider Services

<div class="groups-page">
    <header class="groups-header">
        <div>
            <h1>Concurrency Groups</h1>
            <p>Identify saturation and blocked work across resource pools.</p>
        </div>
    </header>

    @if (_loadError is not null)
    {
        <section class="groups-message groups-message--error" aria-live="polite">
            <span class="material-symbols-outlined" aria-hidden="true">error</span>
            <div>
                <h2>Concurrency groups failed to load</h2>
                <p>@_loadError</p>
            </div>
        </section>
    }
    else if (_isLoading && _page is null)
    {
        <section class="groups-message" aria-live="polite">
            <span class="material-symbols-outlined" aria-hidden="true">progress_activity</span>
            <div>
                <h2>Loading concurrency groups</h2>
                <p>Reading scheduler group occupancy and blocked work.</p>
            </div>
        </section>
    }
    else
    {
        var visibleGroups = FilteredGroups;

        @if (LiveRefresh.RefreshError is not null)
        {
            <DashboardInlineAlert CssClass="groups-inline-alert groups-inline-alert--error" Icon="warning">
                <span>Refresh failed: @LiveRefresh.RefreshError</span>
            </DashboardInlineAlert>
        }

        @if (_actionMessage is not null)
        {
            <DashboardInlineAlert CssClass="@ActionAlertClass" Icon="@ActionAlertIcon">
                <span>@_actionMessage</span>
            </DashboardInlineAlert>
        }

        <DashboardTableShell Title="Group Registry" ResultText="@ResultRangeText" ShowLoadMore="@(_page?.ContinuationToken is not null)" IsLoadingMore="@_isLoadingMore" OnLoadMore="LoadMoreAsync">
            <Toolbar>
                <DashboardFilterSwitch Label="Saturated only" Checked="@_filters.SaturatedOnly" CheckedChanged="SetSaturatedOnlyAsync" Disabled="@_isLoading" />
                <DashboardFilterSwitch Label="Has blocked jobs" Checked="@_filters.HasBlockedJobsOnly" CheckedChanged="SetHasBlockedJobsOnlyAsync" Disabled="@_isLoading" />
                <DashboardSearchBox Value="@_filters.GroupKey" ValueChanged="SetGroupKeyFilter" Placeholder="Filter by group key..." AriaLabel="Filter by group key" />
            </Toolbar>
            <ChildContent>
                <table class="groups-table">
                    <colgroup>
                        <col class="groups-table__col--key" />
                        <col class="groups-table__col--number" />
                        <col class="groups-table__col--source" />
                        <col class="groups-table__col--number" />
                        <col class="groups-table__col--number" />
                        <col class="groups-table__col--state" />
                        <col class="groups-table__col--timestamp" />
                        @if (CanEditLimits)
                        {
                            <col class="groups-table__col--actions" />
                        }
                    </colgroup>
                    <thead>
                        <tr>
                            <th>Group Key</th>
                            <th class="groups-table__number">Effective Limit</th>
                            <th>Limit Source</th>
                            <th class="groups-table__number">Current Occupancy</th>
                            <th class="groups-table__number">Blocked Jobs</th>
                            <th>Saturation State</th>
                            <th>Last Updated</th>
                            @if (CanEditLimits)
                            {
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (visibleGroups.Count == 0)
                        {
                            <tr>
                                <td class="groups-empty-row" colspan="@GroupTableColumnCount">@EmptyText</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var group in visibleGroups)
                            {
                                <tr class="@GroupRowClass(group)" @key="group.GroupKey">
                                    <td>
                                        <span class="groups-key" title="@group.GroupKey">@group.GroupKey</span>
                                    </td>
                                    <td class="groups-table__number">
                                        @if (IsEditing(group))
                                        {
                                            <input class="groups-limit-input" type="number" min="1" step="1"
                                                   aria-label="@LimitInputLabel(group)" @bind="_limitInput" disabled="@_isActionRunning" />
                                        }
                                        else
                                        {
                                            <span class="groups-count">@DashboardFormat.Count(group.EffectiveLimit)</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="@LimitSourceClass(group)" title="@LimitSourceTitle(group)">@LimitSourceText(group)</span>
                                    </td>
                                    <td class="groups-table__number groups-count">@DashboardFormat.Count(group.CurrentOccupancy)</td>
                                    <td class="groups-table__number">
                                        <span class="@BlockedCountClass(group)">@DashboardFormat.Count(group.BlockedJobCount)</span>
                                    </td>
                                    <td>
                                        <span class="@SaturationStateClass(group)">
                                            <span aria-hidden="true"></span>
                                            @SaturationStateText(group)
                                        </span>
                                    </td>
                                    <td><TimestampBlock BaseClass="groups-timestamp" Value="group.UpdatedAtUtc"
                                                        EmptyText="No updates" AllowFutureRelative="false" /></td>
                                    @if (CanEditLimits)
                                    {
                                        <td>
                                            <div class="groups-actions">
                                                @if (IsEditing(group))
                                                {
                                                    <button class="groups-icon-button groups-icon-button--primary" type="button" title="Save Limit"
                                                            aria-label="@SaveLimitLabel(group)" @onclick="@(() => SaveLimitAsync(group))" disabled="@IsActionDisabled">
                                                        <span class="material-symbols-outlined" aria-hidden="true">save</span>
                                                    </button>
                                                    <button class="groups-icon-button" type="button" title="Cancel Edit"
                                                            aria-label="@CancelEditLabel(group)" @onclick="CancelEdit" disabled="@_isActionRunning">
                                                        <span class="material-symbols-outlined" aria-hidden="true">close</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="groups-icon-button" type="button" title="Edit Limit"
                                                            aria-label="@EditLimitLabel(group)" @onclick="@(() => StartEdit(group))" disabled="@IsActionDisabled">
                                                        <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                                                    </button>
                                                    <button class="groups-icon-button" type="button" title="Reset Override"
                                                            aria-label="@ResetLimitLabel(group)" @onclick="@(() => ResetLimitAsync(group))"
                                                            disabled="@(IsActionDisabled || group.OverrideLimit is null)">
                                                        <span class="material-symbols-outlined" aria-hidden="true">restart_alt</span>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </ChildContent>
        </DashboardTableShell>
    }
</div>

<style>
    .groups-page {
        display: flex;
        flex-direction: column;
        gap: var(--sd-gutter);
    }

    .groups-header {
        display: flex;
        align-items: center;
    }

    .groups-header {
        justify-content: space-between;
        gap: 16px;
    }

    .groups-header p {
        margin-top: 4px;
        color: var(--sd-on-surface-variant);
        font-size: 12px;
        line-height: 16px;
    }

    .groups-message,
    .groups-inline-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 2px;
        background: var(--sd-surface-lowest);
        padding: 16px;
    }

    .groups-message .material-symbols-outlined,
    .groups-inline-alert .material-symbols-outlined {
        color: var(--sd-primary);
    }

    .groups-message--error,
    .groups-inline-alert--error {
        border-color: var(--sd-error);
        background: var(--sd-error-container);
        color: var(--sd-on-error-container);
    }

    .groups-message--error .material-symbols-outlined,
    .groups-inline-alert--error .material-symbols-outlined {
        color: var(--sd-error);
    }

    .groups-message p,
    .groups-inline-alert {
        color: var(--sd-on-surface-variant);
    }

    .groups-inline-alert--error {
        color: var(--sd-on-error-container);
    }

    .groups-inline-alert--success {
        border-color: var(--sd-success);
        background: var(--sd-success-container);
        color: var(--sd-success);
    }

    .groups-inline-alert--success .material-symbols-outlined {
        color: var(--sd-success);
    }

    .groups-table {
        min-width: 1320px;
        table-layout: fixed;
        white-space: nowrap;
    }

    .groups-table__col--key {
        width: 320px;
    }

    .groups-table__col--number {
        width: 136px;
    }

    .groups-table__col--source {
        width: 148px;
    }

    .groups-table__col--state {
        width: 176px;
    }

    .groups-table__col--timestamp {
        width: 204px;
    }

    .groups-table__col--actions {
        width: 116px;
    }

    .groups-table thead {
        position: sticky;
        top: 0;
        z-index: 1;
        background: var(--sd-surface-low);
    }

    .groups-table th,
    .groups-table td {
        border-bottom: 1px solid var(--sd-outline-variant);
        padding: 6px 8px;
        text-align: left;
        vertical-align: middle;
    }

    .groups-table th {
        color: var(--sd-on-surface-variant);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.05em;
        line-height: 12px;
        text-transform: uppercase;
    }

    .groups-table td {
        height: 40px;
        color: var(--sd-on-surface);
        font-size: 12px;
        line-height: 16px;
    }

    .groups-table tbody tr:hover {
        background: var(--sd-surface-low);
    }

    .groups-row--saturated {
        background: color-mix(in srgb, var(--sd-error) 8%, transparent);
    }

    .groups-table__number {
        text-align: right;
    }

    .groups-key,
    .groups-count,
    .groups-blocked-count,
    .groups-timestamp__absolute {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }

    .groups-key {
        display: block;
        overflow: hidden;
        color: var(--sd-primary);
        font-size: 13px;
        line-height: 18px;
        text-overflow: ellipsis;
    }

    .groups-blocked-count--attention {
        color: var(--sd-error);
        font-weight: 700;
    }

    .groups-state {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 2px;
        padding: 2px 8px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.05em;
        line-height: 12px;
        text-transform: uppercase;
    }

    .groups-state span {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: var(--sd-outline);
    }

    .groups-state--saturated {
        border-color: var(--sd-error);
        background: color-mix(in srgb, var(--sd-error) 14%, var(--sd-surface-lowest));
        color: var(--sd-error);
    }

    .groups-state--saturated span,
    .groups-state--blocked span {
        background: var(--sd-error);
    }

    .groups-state--blocked {
        border-color: var(--sd-error-container);
        background: var(--sd-surface-variant);
        color: var(--sd-error);
    }

    .groups-state--high {
        border-color: var(--sd-warning-container);
        background: var(--sd-warning-container);
        color: var(--sd-warning);
    }

    .groups-state--high span {
        background: var(--sd-warning);
    }

    .groups-state--nominal {
        background: var(--sd-surface-variant);
        color: var(--sd-on-surface-variant);
    }

    .groups-source {
        display: inline-flex;
        align-items: center;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 2px;
        padding: 2px 8px;
        color: var(--sd-on-surface-variant);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.05em;
        line-height: 12px;
        text-transform: uppercase;
    }

    .groups-source--override {
        border-color: var(--sd-primary);
        background: color-mix(in srgb, var(--sd-primary) 12%, var(--sd-surface-lowest));
        color: var(--sd-primary);
    }

    .groups-source--default {
        border-color: var(--sd-outline);
        background: var(--sd-surface-variant);
        color: var(--sd-on-surface);
    }

    .groups-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 4px;
    }

    .groups-icon-button {
        display: inline-flex;
        width: 30px;
        height: 30px;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 2px;
        background: var(--sd-surface-lowest);
        color: var(--sd-on-surface-variant);
        cursor: pointer;
    }

    .groups-icon-button--primary {
        border-color: var(--sd-primary);
        background: var(--sd-primary);
        color: var(--sd-on-primary);
    }

    .groups-icon-button .material-symbols-outlined {
        font-size: 18px;
        line-height: 18px;
    }

    .groups-icon-button:disabled {
        cursor: not-allowed;
        opacity: 0.5;
    }

    .groups-limit-input {
        width: 92px;
        min-height: 30px;
        border: 1px solid var(--sd-outline-variant);
        border-radius: 2px;
        background: var(--sd-surface-lowest);
        color: var(--sd-on-surface);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        padding: 4px 6px;
        text-align: right;
    }

    .groups-limit-input:focus-visible,
    .groups-icon-button:focus-visible {
        outline: 2px solid var(--sd-primary);
        outline-offset: 1px;
    }

    .groups-timestamp {
        display: flex;
        flex-direction: column;
        gap: 1px;
    }

    .groups-timestamp__relative {
        color: var(--sd-on-surface);
    }

    .groups-timestamp__absolute,
    .groups-empty-row {
        color: var(--sd-on-surface-variant);
        font-size: 11px;
        line-height: 16px;
    }

    .groups-empty-row {
        height: 96px;
        text-align: center;
    }

    @@media (max-width: 1120px) {
        .groups-header {
            align-items: stretch;
            flex-direction: column;
        }
    }
</style>

@code {
    private static readonly TimeSpan PageRefreshInterval = TimeSpan.FromSeconds(5);
    private const int DefaultPageSize = 25;

    private readonly List<ConcurrencyGroupInspectionSummary> _groups = [];
    private readonly DashboardConcurrencyGroupFilters _filters = new();
    private IConcurrencyGroupManager? _manager;
    private ConcurrencyGroupInspectionPage? _page;
    private string? _loadError;
    private string? _actionMessage;
    private string? _editingGroupKey;
    private int _limitInput = 1;
    private bool _isLoading;
    private bool _isLoadingMore;
    private bool _isActionRunning;
    private bool _isActionError;

    private IReadOnlyList<ConcurrencyGroupInspectionSummary> FilteredGroups
      => this._filters.ApplyClientFilter(this._groups);

    private bool CanEditLimits
      => this._manager is not null;

    private int GroupTableColumnCount
      => this.CanEditLimits ? 8 : 7;

    private string ActionAlertClass
      => this._isActionError
        ? "groups-inline-alert groups-inline-alert--error"
        : "groups-inline-alert groups-inline-alert--success";

    private string ActionAlertIcon
      => this._isActionError ? "warning" : "check_circle";

    private bool IsActionDisabled
      => this._isActionRunning || this._isLoading || this._isLoadingMore;

    private string EmptyText
      => this._groups.Count == 0
        ? "No concurrency groups matched the current query."
        : "No loaded concurrency groups matched the group key filter.";

    private string ResultRangeText
    {
        get
        {
            var loadedCount = this._groups.Count;
            var visibleCount = this.FilteredGroups.Count;
            var totalCount = this._page?.TotalCount ?? loadedCount;
            var filteredText = visibleCount == loadedCount
              ? string.Empty
              : string.Create(CultureInfo.InvariantCulture, $" ({DashboardFormat.Count(visibleCount)} visible after group key filter)");
            var moreText = this._page?.ContinuationToken is null ? string.Empty : " with more available";

            return loadedCount == 0
              ? string.Create(CultureInfo.InvariantCulture, $"Showing 0 of {DashboardFormat.Count(totalCount)} groups{filteredText}")
              : string.Create(CultureInfo.InvariantCulture, $"Showing 1-{DashboardFormat.Count(loadedCount)} of {DashboardFormat.Count(totalCount)} groups{filteredText}{moreText}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        this._manager = Services.GetService<IConcurrencyGroupManager>();
        this.InitializeLiveRefresh(
          this.RefreshCurrentQueryAsync,
          showRefreshing: false,
          lastUpdatedUtc: nowUtc => this.LiveRefresh.LastUpdatedUtc ?? (this._page is null ? null : nowUtc));

        await this.LoadAsync();
        this.StartPeriodicRefresh(PageRefreshInterval);
    }

    private async Task SetSaturatedOnlyAsync(bool value)
    {
        this._filters.SaturatedOnly = value;
        this.ClearActionAlert();
        this.CancelEdit();

        await this.LoadAsync();
    }

    private async Task SetHasBlockedJobsOnlyAsync(bool value)
    {
        this._filters.HasBlockedJobsOnly = value;
        this.ClearActionAlert();
        this.CancelEdit();

        await this.LoadAsync();
    }

    private void SetGroupKeyFilter(string value)
    {
        this._filters.GroupKey = value;
        this.ClearActionAlert();
    }

    private async Task LoadAsync()
    {
        this._loadError = null;
        this.LiveRefresh.ClearError();
        this._isLoading = true;

        try
        {
            var page = await Reader.SearchConcurrencyGroupsAsync(this._filters.ToQuery(DefaultPageSize, continuationToken: null));
            this.ReplaceGroups(page);
            this.LiveRefresh.MarkUpdated();
        }
        catch (Exception exception)
        {
            this._loadError = exception.Message;
        }
        finally
        {
            this._isLoading = false;
            this.NotifyShellRefreshChanged();
        }
    }

    private async Task LoadMoreAsync()
    {
        if (this._page?.ContinuationToken is null || this._isLoadingMore)
        {
            return;
        }

        this._loadError = null;
        this._isLoadingMore = true;

        try
        {
            var page = await Reader.SearchConcurrencyGroupsAsync(this._filters.ToQuery(DefaultPageSize, this._page.ContinuationToken));
            this._groups.AddRange(page.Groups);
            this._page = page;
            this.LiveRefresh.MarkUpdated();
        }
        catch (Exception exception)
        {
            this._loadError = exception.Message;
        }
        finally
        {
            this._isLoadingMore = false;
            this.NotifyShellRefreshChanged();
        }
    }

    private async Task RefreshCurrentQueryAsync(CancellationToken cancellationToken)
    {
        var visiblePageSize = Math.Max(DefaultPageSize, this._groups.Count);
        var page = await Reader.SearchConcurrencyGroupsAsync(
          this._filters.ToQuery(visiblePageSize, continuationToken: null),
          cancellationToken)
          ;

        await this.ApplyPageStateAsync(() => this.ReplaceGroups(page));
    }

    private void ReplaceGroups(ConcurrencyGroupInspectionPage page)
    {
        this._groups.Clear();
        this._groups.AddRange(page.Groups);
        this._page = page;
        this._loadError = null;
        if (this._editingGroupKey is not null && page.Groups.All(group => !string.Equals(group.GroupKey, this._editingGroupKey, StringComparison.Ordinal)))
        {
            this.CancelEdit();
        }
    }

    private void StartEdit(ConcurrencyGroupInspectionSummary group)
    {
        if (this.IsActionDisabled)
        {
            return;
        }

        this.ClearActionAlert();
        this._editingGroupKey = group.GroupKey;
        this._limitInput = group.OverrideLimit ?? group.EffectiveLimit;
    }

    private void CancelEdit()
      => this._editingGroupKey = null;

    private async Task SaveLimitAsync(ConcurrencyGroupInspectionSummary group)
    {
        if (this._manager is null || this.IsActionDisabled || !this.IsEditing(group))
        {
            return;
        }

        if (this._limitInput <= 0)
        {
            this.SetActionFailure("Limit save failed: Limit must be positive.");
            return;
        }

        this._isActionRunning = true;
        this.ClearActionAlert();

        try
        {
            await this._manager.SetLimitAsync(group.GroupKey, this._limitInput);
            this.CancelEdit();
            this.SetActionSuccess(string.Create(CultureInfo.InvariantCulture, $"Concurrency group {group.GroupKey} override set to {DashboardFormat.Count(this._limitInput)}."));
            await this.LiveRefresh.RefreshNowAsync();
        }
        catch (Exception exception)
        {
            this.SetActionFailure(string.Create(CultureInfo.InvariantCulture, $"Limit save failed: {exception.Message}"));
        }
        finally
        {
            this._isActionRunning = false;
        }
    }

    private async Task ResetLimitAsync(ConcurrencyGroupInspectionSummary group)
    {
        if (this._manager is null || this.IsActionDisabled)
        {
            return;
        }

        this._isActionRunning = true;
        this.ClearActionAlert();

        try
        {
            await this._manager.ClearLimitOverrideAsync(group.GroupKey);
            if (this.IsEditing(group))
            {
                this.CancelEdit();
            }

            this.SetActionSuccess(string.Create(CultureInfo.InvariantCulture, $"Concurrency group {group.GroupKey} override reset."));
            await this.LiveRefresh.RefreshNowAsync();
        }
        catch (Exception exception)
        {
            this.SetActionFailure(string.Create(CultureInfo.InvariantCulture, $"Limit reset failed: {exception.Message}"));
        }
        finally
        {
            this._isActionRunning = false;
        }
    }

    private bool IsEditing(ConcurrencyGroupInspectionSummary group)
      => string.Equals(this._editingGroupKey, group.GroupKey, StringComparison.Ordinal);

    private void ClearActionAlert()
    {
        this._actionMessage = null;
        this._isActionError = false;
    }

    private void SetActionSuccess(string message)
    {
        this._isActionError = false;
        this._actionMessage = message;
    }

    private void SetActionFailure(string message)
    {
        this._isActionError = true;
        this._actionMessage = message;
    }

    private static string GroupRowClass(ConcurrencyGroupInspectionSummary group)
      => group.IsSaturated ? "groups-row--saturated" : string.Empty;

    private static string BlockedCountClass(ConcurrencyGroupInspectionSummary group)
      => group.BlockedJobCount > 0 ? "groups-blocked-count groups-blocked-count--attention" : "groups-blocked-count";

    private static string SaturationStateText(ConcurrencyGroupInspectionSummary group)
    {
        if (group.IsSaturated)
        {
            return "Saturated";
        }

        if (group.BlockedJobCount > 0)
        {
            return "Blocked Work";
        }

        return GetOccupancyRatio(group) >= 0.8 ? "High Load" : "Nominal";
    }

    private static string SaturationStateClass(ConcurrencyGroupInspectionSummary group)
    {
        var modifier = group.IsSaturated
          ? "saturated"
          : group.BlockedJobCount > 0
            ? "blocked"
            : GetOccupancyRatio(group) >= 0.8
              ? "high"
              : "nominal";

        return string.Concat("groups-state groups-state--", modifier);
    }

    private static double GetOccupancyRatio(ConcurrencyGroupInspectionSummary group)
      => group.EffectiveLimit <= 0 ? 0 : (double)group.CurrentOccupancy / group.EffectiveLimit;

    private static string LimitSourceText(ConcurrencyGroupInspectionSummary group)
      => group.OverrideLimit is not null
        ? "Override"
        : group.DefaultLimit is not null ? "Code default" : "Built-in default";

    private static string LimitSourceTitle(ConcurrencyGroupInspectionSummary group)
      => group.OverrideLimit is not null
        ? string.Create(CultureInfo.InvariantCulture, $"Override limit {DashboardFormat.Count(group.OverrideLimit.Value)}.")
        : group.DefaultLimit is not null
          ? string.Create(CultureInfo.InvariantCulture, $"Code default limit {DashboardFormat.Count(group.DefaultLimit.Value)}.")
          : "Built-in default limit 1.";

    private static string LimitSourceClass(ConcurrencyGroupInspectionSummary group)
      => group.OverrideLimit is not null
        ? "groups-source groups-source--override"
        : group.DefaultLimit is not null
          ? "groups-source groups-source--default"
          : "groups-source";

    private static string LimitInputLabel(ConcurrencyGroupInspectionSummary group)
      => string.Create(CultureInfo.InvariantCulture, $"Limit for concurrency group {group.GroupKey}");

    private static string EditLimitLabel(ConcurrencyGroupInspectionSummary group)
      => string.Create(CultureInfo.InvariantCulture, $"Edit limit for concurrency group {group.GroupKey}");

    private static string SaveLimitLabel(ConcurrencyGroupInspectionSummary group)
      => string.Create(CultureInfo.InvariantCulture, $"Save limit for concurrency group {group.GroupKey}");

    private static string CancelEditLabel(ConcurrencyGroupInspectionSummary group)
